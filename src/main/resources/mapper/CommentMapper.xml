<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.muxcraft.mapper.CommentMapper">

    <resultMap id="commentMap" type="com.muxcraft.entity.Comment">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.muxcraft.entity.Comment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comments (project_id, user_id, content)
        VALUES (#{projectId}, #{userId}, #{content})
    </insert>

    <select id="selectPageByProjectId" resultMap="commentMap">
        SELECT * FROM comments WHERE project_id = #{projectId}
        ORDER BY created_at DESC LIMIT #{offset}, #{size}
    </select>

    <select id="countByProjectId" resultType="long">
        SELECT COUNT(*) FROM comments WHERE project_id = #{projectId}
    </select>

    <delete id="deleteById">
        DELETE FROM comments WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM comments WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteByProjectId">
        DELETE FROM comments WHERE project_id = #{projectId}
    </delete>

    <select id="selectById" resultMap="commentMap">
        SELECT * FROM comments WHERE id = #{id}
    </select>

    <select id="selectAllAdmin" resultMap="commentMap">
        SELECT * FROM comments ORDER BY created_at DESC
    </select>

    <select id="selectAdminPage" resultMap="commentMap">
        SELECT * FROM comments ORDER BY created_at DESC LIMIT #{offset}, #{size}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM comments
    </select>

</mapper>