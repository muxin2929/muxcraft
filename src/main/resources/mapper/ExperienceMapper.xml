<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.muxcraft.mapper.ExperienceMapper">

    <resultMap id="experienceMap" type="com.muxcraft.entity.Experience">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="organization" property="organization"/>
        <result column="description" property="description"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="page_url" property="pageUrl"/>
        <result column="start_date" property="startDate"/>
        <result column="end_date" property="endDate"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <insert id="insert" parameterType="com.muxcraft.entity.Experience" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO experiences (title, organization, description, cover_url, page_url, start_date, end_date, sort_order)
        VALUES (#{title}, #{organization}, #{description}, #{coverUrl}, #{pageUrl}, #{startDate}, #{endDate}, #{sortOrder})
    </insert>

    <select id="selectById" resultMap="experienceMap">
        SELECT * FROM experiences WHERE id = #{id}
    </select>

    <select id="selectPage" resultMap="experienceMap">
        SELECT * FROM experiences ORDER BY sort_order ASC, id DESC LIMIT #{offset}, #{size}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM experiences
    </select>

    <update id="update" parameterType="com.muxcraft.entity.Experience">
        UPDATE experiences
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="organization != null">organization = #{organization},</if>
            <if test="description != null">description = #{description},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="pageUrl != null">page_url = #{pageUrl},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM experiences WHERE id = #{id}
    </delete>

    <select id="selectAll" resultMap="experienceMap">
        SELECT * FROM experiences ORDER BY sort_order ASC, id DESC
    </select>

</mapper>